{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WslCodexGui",
  "mainBinaryName": "WslCodexGui",
  "version": "0.5.60",
  "identifier": "io.github.fuyukiyoneyama.wslcodexgui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WSL Codex GUI",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt"
    },
    "publisher": "Fuyuki Yoneyama",
    "copyright": "Copyright (c) 2026 Fuyuki Yoneyama",
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons-src/nsis-header.bmp",
        "sidebarImage": "icons-src/nsis-sidebar.bmp"
      }
    }
  }
}
